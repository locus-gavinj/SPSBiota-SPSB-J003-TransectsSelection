# Assumption is that the workspace temp dir has been already set and created.  See controldefs.cpp - ControlDefs::writeVisualizerTempDir
DEFAULT_MACRO WORKSPACE_TEMP_DIR
DEFAULT_MACRO FME_LAUNCH_VIEWER_APP NO
INCLUDE [    set safeName "[regsub -all {[^a-zA-Z0-9]} {_Transect_2425_Layer} _]_[expr round(rand() * 1000000)]_[clock clicks  -milliseconds]";    puts "MACRO SAFE_FFS_NAME $safeName"; ]
INCLUDE [    if {{NoReduction} == {NoReduction} &&        {NO_THINNING} == {NO_THINNING}} {       puts "MACRO _Transect_2425_Layer_d45dfa7f_939a_47cf_90b8_96009acc149141_LARGE_GEOMETRY_DATA_STORAGE REFERENCE";    } else {       puts "MACRO _Transect_2425_Layer_d45dfa7f_939a_47cf_90b8_96009acc149141_LARGE_GEOMETRY_DATA_STORAGE FULL";    }; ]
INCLUDE [    if {{$(FME_LAUNCH_VIEWER_APP)} != {NO}} {       puts "MACRO ENABLE_RECORDING *";    } else {       puts "MACRO ENABLE_RECORDING _NOT_THIS_TIME_";    }; ]
