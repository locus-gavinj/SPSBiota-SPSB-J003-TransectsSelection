MACRO FeatureReader_OUTPUT_PORTS_ENCODED Transects<space>2425
MACRO FeatureReader_DIRECTIVES AGOL_AUTH_GROUP,FME_DISCLOSURE_OPEN,AGOL_AUTH_NC,$(AGOL_USER_AUTHORIZATION$encode),ALIAS_MODE,NONE,ARCGISFEATURESERVICE_ADV_PARM_GROUP,FME_DISCLOSURE_CLOSED,CREATE_FEATURE_TABLES_FROM_DATA,Yes,EXPOSE_ATTRS_GROUP,FME_DISCLOSURE_CLOSED,FEATURE_SERVICE_WITH_ID,HRSS<lt>space<gt>Locus<lt>space<gt>Transects<lt>space<gt>2425_STAGING<lt>openparen<gt>84818c29e17b42338d1318eebdaff437<lt>closeparen<gt>,FEATURES_PER_REQUEST,1000,FOLDER_NAME,Gavin<lt>space<gt>Scratch,FORMAT_DATETIME,FME_FORMAT,FORMAT_GLOBALID,NO_FORMAT,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,RESOLVE_DOMAINS,NO,SAFE.ESRI-AGOL.ARCGISFEATURESERVICE_EXPOSE_FORMAT_ATTRS,,SELECT_FEATURE_SERVICE_GROUP,FME_DISCLOSURE_OPEN,SITE_SOURCE_TYPE,USER,SPATIAL_GROUP,,TABLELIST,,URL_TYPE,AGOL,USE_SEARCH_ENVELOPE,NO,VERIFY_HTTPS,WEB_CONN
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {NONE} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "NONE"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_COMBINE_ATTRS RESULT_ONLY";       };    ]
