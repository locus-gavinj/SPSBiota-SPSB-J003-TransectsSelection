FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter_7 } INPUT FEATURE_TYPE TestFilter_7_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Active<closeparen>,TestFilter_7) = Yes ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_7_Active OUTPUT FAILED FEATURE_TYPE TestFilter_7_<lt>UNFILTERED<gt>
